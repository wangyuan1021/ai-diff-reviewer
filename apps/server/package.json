{
  "name": "@ai-diff-reviewer/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "eval": "node --import tsx ../../scripts/evaluate.ts",
    "build": "tsup --config tsup.config.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-diff-reviewer/diff-engine": "workspace:*",
    "@ai-diff-reviewer/shared": "workspace:*",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^14.0.0",
    "dotenv": "^17.2.3",
    "koa": "^3.0.1",
    "koa-bodyparser": "^4.4.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.4",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6"
  }
}
